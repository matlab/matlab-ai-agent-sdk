{
    "aisdk.MCPClient": {
        "inputs": [
            {
                "name": "endpoint",
                "kind": "required",
                "type": "string"
            },
            {
                "name": "Transport",
                "kind": "namevalue",
                "type": "choices={'auto','streamable-http','sse','stdio'}"
            },
            {
                "name": "ToolPrefix",
                "kind": "namevalue",
                "type": [["string", "scalar"]]
            },
            {
                "name": "TimeOut",
                "kind": "namevalue",
                "type": [["numeric", "scalar", ">=0"]]
            }
        ]
    },
    "aisdk.LLMTool": {
        "inputs": [
            {
                "mutuallyExclusiveGroup": [
                    [
                        {
                            "name": "toolDefinition",
                            "kind": "required",
                            "type": [["function_handle"]]
                        },
                        {
                            "name": "Name",
                            "kind": "namevalue",
                            "type": [["string", "scalar"], ["char"]]
                        },
                        {
                            "name": "Description",
                            "kind": "namevalue",
                            "type": [["string", "scalar"], ["char"]]
                        },
                        {
                            "name": "DisplayTitle",
                            "kind": "namevalue",
                            "type": [["string", "scalar"], ["char"]]
                        },
                        {
                            "name": "InputArguments",
                            "kind": "namevalue",
                            "type": [["aisdk.LLMToolArgument"], ["struct"]]
                        },
                        {
                            "name": "OutputArguments",
                            "kind": "namevalue",
                            "type": [["aisdk.LLMToolArgument"], ["struct"]]
                        },
                        {
                            "name": "Annotations",
                            "kind": "namevalue",
                            "type": [["struct", "scalar"]]
                        },
                        {
                            "name": "ApprovalRequest",
                            "kind": "namevalue",
                            "type": [["choices={'never','once','always'}"]]
                        },
                        {
                            "name": "Workspace",
                            "kind": "namevalue",
                            "type": [["choices={'none','agent'}"]]
                        }
                    ],
                    [
                        {
                            "name": "mcpClient",
                            "kind": "required",
                            "type": [["mcpHTTPClient"], ["aisdk.MCPClient"]]
                        }
                    ]
                ]
            }
        ]
    }
}
