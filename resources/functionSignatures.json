{
    "aisdk.AIAgent": {
        "inputs": [
            {
                "name": "client",
                "kind": "required",
                "type": "aisdk.client.ClientBase"
            },
            {
                "name": "SystemPrompt",
                "kind": "namevalue",
                "type": [["string", "scalar"], ["char"]]
            },
            {
                "name": "Tools",
                "kind": "namevalue",
                "type": "aisdk.tool.LLMTool"
            },
            {
                "name": "Messages",
                "kind": "namevalue",
                "type": "aisdk.message.LLMMessage"
            },
            {
                "name": "ResponseFormat",
                "kind": "namevalue",
                "type": [["choices={'text','json'}"], ["struct"], ["string", "scalar"]]
            },
            {
                "name": "Workspace",
                "kind": "namevalue",
                "type": ["struct", "scalar"]
            },
            {
                "name": "DisplayMode",
                "kind": "namevalue",
                "type": "choices={'off','detailed'}"
            },
            {
                "name": "MaxIterations",
                "kind": "namevalue",
                "type": ["numeric", "scalar", ">0"]
            },
            {
                "name": "ApprovalFcn",
                "kind": "namevalue",
                "type": "function_handle"
            },
            {
                "name": "SkillDirectories",
                "kind": "namevalue",
                "type": [["folder"], ["string"]]
            }
        ]
    },
    "aisdk.AIAgent.loadSkill": {
        "inputs": [
            {
                "name": "agent",
                "kind": "required",
                "type": "aisdk.AIAgent"
            },
            {
                "name": "skill",
                "kind": "required",
                "type": "choices=aisdk.internal.skillCompletions(agent)"
            },
            {
                "name": "resourcePath",
                "kind": "optional",
                "type": "choices=aisdk.internal.skillCompletions(agent,skill)"
            }
        ]
    },
